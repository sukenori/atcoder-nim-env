# zsh 起動時に tmux が未起動なら tmux IDE を自動構築する
if [ -z "${TMUX}" ]; then
  PROJECT_DIR="/home/sukenori/atcoder-nim-env"
  # 接続元デバイスの識別タグ（PC からの起動時は未指定→"pc"扱い、Android からは "mobile" を渡す想定）
  DEVICE_TAG="${DEVICE_TAG:-pc}"
  # デバイスごとに tmux セッションを分ける（PC は従来通り "atcoder-nim"、他デバイスは "atcoder-nim-<タグ>"）
  SESSION_NAME="atcoder-nim"
  [ "${DEVICE_TAG}" != "pc" ] && SESSION_NAME="atcoder-nim-${DEVICE_TAG}"
  # Neovim が外部から操作を受け付けるための通信ファイル（ソケット）のパス（デバイスごとに分けて衝突を防ぐ）
  SOCKET="/tmp/nvimsocket-${DEVICE_TAG}"
  # Neovim が終了しても 0.05 秒後に自動で再起動し、指定したソケットで通信を待ち受ける状態を維持するコマンド文字列
  NVIM_CMD="while :; do rm -f ${SOCKET}; NVIM_LISTEN_ADDRESS=${SOCKET} command nvim; sleep 0.05; done"

  # ${SESSION_NAME} という名前の tmux セッションが存在しなければ構築
  if ! tmux has-session -t "${SESSION_NAME}" 2>/dev/null; then
    # 指定のディレクトリに、main というウィンドウをもつ、${SESSION_NAME} というセッションを新規作成
    tmux new-session -d -s "${SESSION_NAME}" -n main -c "${PROJECT_DIR}" "zsh -lc '${NVIM_CMD}'"
    # ${SESSION_NAME} セッション内の環境変数として、Neovim の通信用ソケットパスを登録
    tmux set-environment -t "${SESSION_NAME}" NVIM_SOCKET_PATH "${SOCKET}"
    # 画面を縦に分割して下側に新しい領域を作り、そこに zsh を起動する（下側の zsh を終了させると、${SESSION_NAME} セッション全体が破棄される）
    tmux split-window -v -l 2 -t "${SESSION_NAME}:0" -c "${PROJECT_DIR}" "zsh -l; tmux kill-session -t ${SESSION_NAME}"
  fi

  # Neovim 側（ペイン 0）ではなく、後から作った下側の zsh 画面（ペイン 1）に操作のフォーカス
  tmux select-pane -t "${SESSION_NAME}:0.1"
  # 現在のシェルから tmux の ${SESSION_NAME} セッションに接続
  exec tmux attach-session -t "${SESSION_NAME}"
fi

# nw： nvim work の略、複数指定も可能
nw() {
  local root
  local -a files
  local file
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    print -u2 'nw: run this inside atcoder-nim-env'
    return 1
  }
  if (( $# == 0 )); then
    nvim "$root/work"
    return
  fi
  for file in "$@"; do
    files+=("$root/work/$file")
  done
  nvim "${files[@]}"
}

# nc： コンテスト名を入れると、a～e までのテンプレ付きファイルを生成して開く
nc() {
  if (( $# != 1 )); then
    print -u2 'usage: nc <contest-id>'
    return 2
  fi
  local contest="$1"
  local root
  local work
  local problem
  local file
  local -a files
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    print -u2 'nc: run this inside atcoder-nim-env'
    return 1
  }
  work="$root/work"
  [[ -d "$work" ]] || {
    print -u2 "nc: work directory not found: $work"
    return 1
  }
  for problem in a b c d e; do
    file="$work/${contest}${problem}.nim"
    files+=("$file")
    if [[ -e "$file" ]]; then
      print -u2 "nc: already exists, aborted: $file"
      return 1
    fi
  done
  for file in "${files[@]}"; do
    printf 'include "template.nim"\n\n' > "$file"
    print -- "created: ${file#$root/}"
  done
  nvim "${files[@]}"
}